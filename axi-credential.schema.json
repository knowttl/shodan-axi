{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/knowttl/shodan-axi/axi-credential.schema.json",
  "title": "Shodan credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["auth"],
  "properties": {
    "auth": { "type": "string", "enum": ["api-key", "none"] },
    "origin": { "type": "string", "pattern": "^https://[^/?#@]+$", "default": "https://api.shodan.io" },
    "streamOrigin": { "type": "string", "pattern": "^https://[^/?#@]+$" },
    "apiKey": { "$ref": "#/definitions/secretRef", "x-secret": true, "default": { "env": "SHODAN_AXI_API_KEY" } }
  },
  "allOf": [
    { "if": { "properties": { "auth": { "const": "none" } }, "required": ["auth"] }, "then": { "not": { "required": ["apiKey"] } } }
  ],
  "definitions": {
    "secretRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+" } } }
      ]
    }
  }
}
