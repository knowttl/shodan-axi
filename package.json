{
  "name": "@knowttl/shodan-axi",
  "version": "0.1.2",
  "description": "Agent-facing Shodan account and investigation reads",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/knowttl/shodan-axi.git"
  },
  "bin": {
    "shodan-axi": "bin/shodan-axi.js"
  },
  "files": [
    "bin/",
    "dist/",
    "axi-credential.schema.json",
    "command-inventory.json",
    "COMMISSIONING.md",
    "skills/"
  ],
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc",
    "generate": "npm run build && node scripts/check-generated.ts --write",
    "typecheck": "tsc -p tsconfig.tooling.json",
    "check": "npm run build && npm run typecheck && eslint --flag unstable_native_nodejs_ts_config src && node scripts/check-generated.ts && node --test tests/types.test.ts tests/account.test.ts",
    "check:slice": "node scripts/check-slice.ts",
    "test": "node --test tests/*.test.ts",
    "prepack": "npm run build && npm run check"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "exceljs": "4.4.0",
    "ipaddr.js": "2.2.0",
    "jpeg-js": "0.4.4",
    "toml-eslint-parser": "1.0.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "fast-xml-parser": "5.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
